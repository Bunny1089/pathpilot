# PathPilot Environment Configurations (Example)

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1

# SQLite database path. Default points to backend folder
DATABASE_URL=sqlite:///./pathpilot.db

# CORS Allowed Origins for frontend dev server
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Future AI provider selection placeholder ('local' or 'gemini')
# NOTE: AI execution is disabled in Phase 1
AI_PROVIDER=local

# Google Gemini API key (Required in Phase 2+ if using Gemini provider)
# GEMINI_API_KEY=your_gemini_api_key_here
